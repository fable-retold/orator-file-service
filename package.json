{
  "name": "orator-file-service",
  "version": "1.0.0",
  "description": "Reusable Orator file service: HTTP Range byte serving with a host-supplied resolver seam, plus retold-sharp (libvips) image derivatives and Deep Zoom (DZI) tile pyramids.",
  "main": "source/Orator-File-Service.js",
  "files": [
    "source"
  ],
  "scripts": {
    "test": "npx quack test",
    "coverage": "npx quack coverage",
    "tests": "npx mocha -u tdd -R spec test/*.js"
  },
  "mocha": {
    "diff": true,
    "extension": [
      "js"
    ],
    "package": "./package.json",
    "reporter": "spec",
    "slow": "75",
    "timeout": "20000",
    "ui": "tdd",
    "watch-files": [
      "source/**/*.js",
      "test/**/*.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fable-retold/orator-file-service.git"
  },
  "keywords": [
    "orator",
    "retold",
    "http",
    "range",
    "byte-serving",
    "deep-zoom",
    "dzi",
    "tiles",
    "openseadragon",
    "libvips",
    "sharp"
  ],
  "author": "steven velozo <steven@velozo.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fable-retold/orator-file-service/issues"
  },
  "homepage": "https://github.com/fable-retold/orator-file-service#readme",
  "dependencies": {
    "fable-serviceproviderbase": "^3.0.19",
    "mime": "^3.0.0"
  },
  "optionalDependencies": {
    "retold-sharp": "^1.0.0"
  },
  "devDependencies": {
    "chai": "^4.3.10",
    "fable": "^3.1.83",
    "mocha": "^10.4.0",
    "orator": "^6.1.3",
    "orator-serviceserver-restify": "^2.0.12",
    "quackage": "^1.3.0",
    "retold-sharp": "^1.0.0"
  }
}
